{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Patitas Felices: tienda WooCommerce",
    "description": "Prototipo académico (INACAP, E-Commerce) de tienda para mascotas en Copiapó sobre WordPress + WooCommerce.",
    "author": "jrmxs",
    "categories": [
      "WooCommerce"
    ]
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "wordpress.org/themes",
        "slug": "storefront"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteLanguage",
      "language": "es_CL"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/jrmxs/patitas-felices/main/patitas-felices.zip?v=20261116181645"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; patitas_instalar();"
    },
    {
      "step": "login",
      "username": "felipe",
      "password": "patitas2026"
    }
  ]
}